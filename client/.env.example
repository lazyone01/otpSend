# Where the frontend sends API requests (no trailing slash).
#
# Development: the Express server directly
VITE_API_URL=http://localhost:5000
#
# Production on Vercel (recommended): leave VITE_API_URL EMPTY / unset.
#   Requests then go to /api on the frontend's own domain and vercel.json forwards them to the
#   backend, so the login cookie is first-party and works in every browser (including Safari).
#
# Production calling the backend directly (not recommended - Safari blocks the cookie):
#   VITE_API_URL=https://your-backend.onrender.com   and on the server COOKIE_SAMESITE=none
#
# Anything starting with VITE_ is built into the public JavaScript. Never put secrets here.
