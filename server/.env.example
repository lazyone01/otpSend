# Copy this file to .env and fill it in. NEVER commit .env - it holds your secrets.
# In production, enter these in your host's dashboard (e.g. Render -> Environment) instead.

# ---------- Server ----------
# Port to listen on. Hosting platforms set PORT themselves - don't set it there.
PORT=5000

# "development" locally, "production" on the deployed server.
NODE_ENV=development

# Exact URL of the React app, no trailing slash. Used for CORS, CSRF checks and reset-email links.
# Development: http://localhost:5174
# Production:  https://your-app.vercel.app
CLIENT_URL=http://localhost:5174

# How many proxies sit in front of the server (used to find the real client IP for rate limiting).
# Leave empty: defaults to 0 in development and 1 in production.
# Vercel /api proxy -> Render: 4 (Vercel, Cloudflare, Render load balancer, Render internal hop).
TRUST_PROXY=

# SameSite setting of the login cookie: lax | none | strict.
# Leave empty (= lax) locally AND when using the recommended Vercel /api proxy.
# "none" only if the browser calls the API on a different domain directly (production/HTTPS only).
COOKIE_SAMESITE=

# ---------- Database ----------
# MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers).
# Use a different database name for production, e.g. .../otpSend-prod?...
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/otpSend?retryWrites=true&w=majority

# ---------- Secrets ----------
# Long random strings. Generate EACH ONE separately with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use different values in development and production.
OTP_SECRET=
JWT_SECRET=

# How long a login lasts (e.g. 1h, 1d, 7d).
JWT_EXPIRES_IN=7d

# ---------- Email ----------
# smtp  = send through any SMTP server with Nodemailer (good for development)
# brevo = send through Brevo's HTTPS API (use on hosts that block SMTP, e.g. free tiers)
EMAIL_PROVIDER=smtp

# Sender shown in the inbox. Must be an address your provider lets you send from
# (Gmail: your Gmail address; Brevo: a verified sender).
EMAIL_FROM="OTP Auth <you@example.com>"

# Used when EMAIL_PROVIDER=smtp
# Gmail:  smtp.gmail.com / 465 / your Gmail address / 16-char App Password
# Brevo:  smtp-relay.brevo.com / 587 / Brevo SMTP login / SMTP key
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Used when EMAIL_PROVIDER=brevo (Brevo -> SMTP & API -> API Keys)
BREVO_API_KEY=
